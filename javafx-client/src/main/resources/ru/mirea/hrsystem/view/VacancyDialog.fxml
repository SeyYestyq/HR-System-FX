<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.mirea.hrsystem.ui.VacancyDialogController"
      spacing="10">

    <padding><Insets top="10" right="10" bottom="0" left="10"/></padding>

    <GridPane hgap="10" vgap="10">
        <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

        <Label text="Название вакансии *:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="titleField" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Работодатель (Компания) *:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <ComboBox fx:id="employerComboBox" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Зарплата от (₽):" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="salaryMinField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Зарплата до (₽):" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="salaryMaxField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <Label text="Статус:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <ComboBox fx:id="statusComboBox" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

        <Label text="Описание:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <TextArea fx:id="descriptionArea" prefRowCount="3" prefWidth="300" wrapText="true"
                  GridPane.columnIndex="1" GridPane.rowIndex="5"/>
    </GridPane>

    <Label fx:id="errorLabel" wrapText="true"
           style="-fx-text-fill: #c73545; -fx-font-weight: bold;"/>
</VBox>
