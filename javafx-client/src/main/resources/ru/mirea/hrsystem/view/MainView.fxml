<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.mirea.hrsystem.ui.MainController"
      spacing="0" prefWidth="1050" prefHeight="650"
      stylesheets="@../css/app.css">

    <!-- ВЕРХНИЙ ХЕДЕР -->
    <HBox alignment="CENTER_LEFT" spacing="15" styleClass="header">
        <padding><Insets top="14" right="20" bottom="14" left="20"/></padding>
        <Label text="HireSystem" styleClass="brand-mark"/>
        <VBox alignment="CENTER_LEFT">
            <Label text="Управление вакансиями и специалистами" styleClass="header-title"/>
            <Label text="Настольный клиент • Подключение к PostgreSQL" styleClass="muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="dbStatusLabel" text="🟢 База данных подключена" styleClass="header-status"/>
        <Button fx:id="refreshButton" text="⟳ Обновить" onAction="#handleRefresh" styleClass="secondary-button"/>
    </HBox>

    <!-- ПАНЕЛЬ УПРАВЛЕНИЯ И ПОИСКА -->
    <VBox spacing="10" styleClass="toolbar-panel">
        <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
        
        <!-- КНОПКИ ДЕЙСТВИЙ -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button fx:id="addButton" text="+ Новая вакансия" onAction="#handleAddVacancy" styleClass="primary-button"/>
            <Button fx:id="editButton" text="✎ Редактировать" onAction="#handleEditVacancy" styleClass="secondary-button"/>
            <Button fx:id="deleteButton" text="🗑 Удалить" onAction="#handleDeleteVacancy" styleClass="danger-button"/>
            <Separator orientation="VERTICAL"/>
            <Button text="📊 Статистика (5 показателей)" onAction="#handleShowStatistics" styleClass="secondary-button"/>
            <Button fx:id="exportButton" text="📥 Экспорт в CSV" onAction="#handleExportCsv" styleClass="secondary-button"/>
        </HBox>

        <!-- ПАНЕЛЬ ЖИВОГО ПОИСКА И ФИЛЬТРОВ -->
        <HBox spacing="12" alignment="CENTER_LEFT">
            <TextField fx:id="searchField" promptText="🔍 Поиск по названию, компании или описанию..." prefWidth="300"/>
            <Label text="Статус:"/>
            <ComboBox fx:id="statusFilterComboBox" prefWidth="150"/>
            <Label text="Зарплата:"/>
            <ComboBox fx:id="salaryRangeFilterComboBox" prefWidth="190"/>
            <Button text="✕ Сброс" onAction="#handleResetFilters" styleClass="link-button"/>
        </HBox>
    </VBox>

    <!-- ТАБЛИЦА С ДАННЫМИ -->
    <VBox VBox.vgrow="ALWAYS">
        <padding><Insets top="0" right="20" bottom="10" left="20"/></padding>
        <TableView fx:id="vacancyTableView" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>
                <TableColumn fx:id="titleColumn" text="Название вакансии" prefWidth="250"/>
                <TableColumn fx:id="employerColumn" text="Работодатель / Компания" prefWidth="180"/>
                <TableColumn fx:id="salaryMinColumn" text="Зарплата от (₽)" prefWidth="130"/>
                <TableColumn fx:id="salaryMaxColumn" text="Зарплата до (₽)" prefWidth="130"/>
                <TableColumn fx:id="statusColumn" text="Статус" prefWidth="120"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>

    <!-- НИЖНЯЯ СТРОКА СОСТОЯНИЯ -->
    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="status-bar">
        <padding><Insets top="6" right="20" bottom="6" left="20"/></padding>
        <Label fx:id="countLabel" text="Показано: 0 вакансий" styleClass="muted"/>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>
</VBox>
